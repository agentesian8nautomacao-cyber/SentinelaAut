# B7 — Linux-built local-api-pilot (clone isolated network). npm ci inside image (no Windows node_modules).
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY scripts/n8n-harness scripts/n8n-harness
COPY api api
COPY sentinela/core sentinela/core
COPY utils utils
COPY types.ts tsconfig.json vitest.config.ts ./
ENV SENTINELA_PILOT_ISOLATED_DOCKER=1
ENV SENTINELA_PILOT_HOST=0.0.0.0
ENV SENTINELA_PILOT_PORT=3099
EXPOSE 3099
CMD ["node", "scripts/n8n-harness/run-local-api-pilot.mjs"]
