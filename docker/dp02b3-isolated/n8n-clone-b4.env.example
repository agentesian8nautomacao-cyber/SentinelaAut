# D-P0-2B-4B / B6 — Clone n8n isolado (sentinelaaut-n8n-dp02b3-import).
# Copiar para n8n-clone-b4.env (gitignored). Valores sintéticos apenas — NÃO produção.

# --- n8n Code node ---
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Agent Gateway (AUT-2F-001 webhook) ---
SENTINELA_AGENT_GATEWAY_ENABLED=1
SENTINELA_AGENT_GATEWAY_HARNESS_RUNTIME=local_n8n
SENTINELA_AGENT_GATEWAY_TIMESTAMP_WINDOW_SECONDS=300
SENTINELA_AGENT_GATEWAY_NONCE_STORE=persistent
SENTINELA_AGENT_GATEWAY_NONCE_CONSUME_URL=http://sentinelaaut-agent-nonce-sidecar-dp02b3:3098/api/v1/agent-gateway/nonce/consume
# SENTINELA_AGENT_GATEWAY_INTERNAL_TOKEN=
# SENTINELA_AGENT_GATEWAY_SECRETS=[{"key_id":"...","secret":"...","status":"active"}]
# SENTINELA_AGENT_GATEWAY_ALLOWED_KEY_IDS=
# SENTINELA_AGENT_GATEWAY_IDENTITY_REGISTRY=

# --- Sentinela API v1 (workflows filhos AUT-010 / AUT-3B-* — nó Generate HMAC) ---
# Com rede isolada (Internal): usar piloto no namespace do clone (sidecar --network container:…).
SENTINELA_API_BASE_URL=http://127.0.0.1:3099
SENTINELA_PILOT_BASE=http://127.0.0.1:3099
SENTINELA_N8N_CLIENT_ID=n8n-pilot-test
SENTINELA_N8N_SECRET=test-secret-do-not-use-in-prod
SENTINELA_HARNESS_CLIENT_ID=n8n-pilot-test
SENTINELA_HARNESS_SECRET=test-secret-do-not-use-in-prod
SENTINELA_N8N_ORGANIZATION_ID=0e5a5c4b-4cc6-48ee-8c1b-08d5015ab928
SENTINELA_N8N_CONDOMINIUM_ID=3f383313-5ec0-4d21-97c7-1b2500c933be
SENTINELA_HARNESS_ORG=0e5a5c4b-4cc6-48ee-8c1b-08d5015ab928
SENTINELA_HARNESS_CONDO=3f383313-5ec0-4d21-97c7-1b2500c933be

# NÃO definir DATABASE_URL / Supabase / credenciais LIVE neste ficheiro.
