# D-P0-2B-4B-A — Template de env para persistência de nonce no CLONE isolado (dp02b3).
# NÃO aplicar no sentinelaaut-n8n-local. NÃO commitar valores reais.
# Copiar para vault / docker env do clone apenas após autorização operacional.

# --- n8n (clone sentinelaaut-n8n-dp02b3-import) ---
SENTINELA_AGENT_GATEWAY_ENABLED=1
# JSON array: key_id + secret (status active) — valor no vault
# SENTINELA_AGENT_GATEWAY_SECRETS=
SENTINELA_AGENT_GATEWAY_NONCE_STORE=persistent
SENTINELA_AGENT_GATEWAY_NONCE_CONSUME_URL=http://<host-reachable-from-clone>/api/v1/agent-gateway/nonce/consume
# Token interno — valor no vault (par com identity registry na API)
# SENTINELA_AGENT_GATEWAY_INTERNAL_TOKEN=
SENTINELA_AGENT_GATEWAY_TIMESTAMP_WINDOW_SECONDS=300
# Webhook exige rawBody no nó aut-2f-001-webhook (artefato D-P0-1)

# --- API consume (processo Node no host ou sidecar; NÃO Vercel prod nesta fase) ---
# SENTINELA_AGENT_GATEWAY_NONCE_SQLITE_PATH=/var/lib/sentinela/clone-agent-nonces.sqlite
# ou PostgreSQL após migration 022 aplicada com autorização:
# DATABASE_URL=postgres://...
# SENTINELA_AGENT_GATEWAY_ALLOWED_KEY_IDS=<key_id-demo>
# SENTINELA_AGENT_GATEWAY_IDENTITY_REGISTRY=[{"identity_id":"...","internal_tokens":["..."],"key_ids":["..."]}]
