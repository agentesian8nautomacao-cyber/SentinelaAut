# Copie para .env.local e preencha os valores.
# NUNCA commite arquivos .env/.env.local (mesmo em repositório privado).

# Modo do app: "production" (web/Vercel) ou "local" (rede interna)
VITE_APP_MODE=production

# Supabase (obrigatório)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY

# URL pública do app (usada para links de recuperação e redirects)
VITE_APP_URL=https://seu-app.vercel.app
# (Opcional, server-only) URL pública preferida para links gerados na API (ex.: e-mail de convite).
# Se omitida, a API usa VITE_APP_URL ou VERCEL_URL no runtime serverless.
# APP_URL=https://seu-app.vercel.app
# (Opcional) URL explícita de redirect para recuperação de senha
VITE_SUPABASE_REDIRECT=https://seu-app.vercel.app/reset-password

# Gemini API (obrigatório para IA: chat/voz/relatórios)
# Aceita: GEMINI_API_KEY, VITE_GEMINI_API_KEY ou API_KEY
GEMINI_API_KEY=SUA_GEMINI_API_KEY

# Monitoramento de erros (opcional, recomendado)
# Use a URL DSN do projeto no Sentry (ex: https://xxx@xxx.ingest.sentry.io/xxx).
# NÃO cole o comando do wizard (npx @sentry/wizard...) aqui.
VITE_SENTRY_DSN=

# Supabase server-only (API / Vercel Serverless). NUNCA VITE_* para service role.
# O frontend usa VITE_*. A API Master usa estas no runtime (process.env):
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUA_SUPABASE_SERVICE_ROLE_KEY

# Postgres direto (server-only) — transações de provisionamento operacional (P0-22).
# Use a connection string do Supabase (Settings → Database). NUNCA VITE_*.
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# P0-24 — Provisionamento operacional (server + UI). Habilitar somente após APPLY migrations 020 + 021.
# SENTINELA_OPERATIONAL_PROVISION_ENABLED=1
# VITE_SENTINELA_OPERATIONAL_PROVISION_ENABLED=1
# Permite create-auth-user para admins legados em users/staff sem membership (transição; default ligado).
# SENTINELA_LEGACY_CREATE_AUTH_ADMIN_PROFILE=1

# --- SENTINELA API v1 (server-side ONLY — nunca VITE_*) ---
# Credentials HMAC (JSON array). Cada client_id é scoped a 1 org + 1 condo.
# SENTINELA_API_CREDENTIALS=[{"client_id":"n8n-pilot","secret":"troque-me","organization_id":"0e5a5c4b-4cc6-48ee-8c1b-08d5015ab928","condominium_id":"3f383313-5ec0-4d21-97c7-1b2500c933be","role_name":"porteiro","permission_keys":["packages.create","packages.update","residents.view"]}]
# Catálogo de tenants para validação fail-closed sem round-trip (opcional em piloto/testes).
# Em produção preferir SELECT em organizations/condominiums (M1/M4) via service role.
# SENTINELA_TENANT_CATALOG=[{"organization_id":"0e5a5c4b-4cc6-48ee-8c1b-08d5015ab928","condominium_id":"3f383313-5ec0-4d21-97c7-1b2500c933be"}]
# Janela anti-replay do timestamp (segundos), default 300
# SENTINELA_API_TIMESTAMP_WINDOW_SECONDS=300
#
# Chave AES-256 (32 bytes) para custódia HITL criptografada (server-only).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ou hex 64 chars. NUNCA commitar. NUNCA VITE_*.
# SENTINELA_HITL_CUSTODY_KEY=
#
# Credencial futura n8n (G7-F) — guardar no vault do n8n / secrets do servidor.
# NÃO commitar valores reais. NÃO usar VITE_*. Mapear no servidor via SENTINELA_API_CREDENTIALS.
# SENTINELA_N8N_CLIENT_ID=
# SENTINELA_N8N_SECRET=
# SENTINELA_N8N_ORGANIZATION_ID=
# SENTINELA_N8N_CONDOMINIUM_ID=
# Base URL da API operacional (n8n). Nunca service_role.
# SENTINELA_API_BASE_URL=https://seu-app.vercel.app
#
# Agent Gateway (AUT-2F-001 webhook) — B16-B. Secrets só no vault n8n / env servidor.
# SENTINELA_AGENT_GATEWAY_ENABLED=1
# SENTINELA_AGENT_GATEWAY_SECRETS=[{"key_id":"agent-demo","secret":"troque-me","status":"active"}]
# SENTINELA_AGENT_GATEWAY_NONCE_STORE=unavailable
# Modos allowlist (B16-B-R1 / B16-C): unavailable | memory_test | persistent
# persistent (B16-C): exige backend — no API: DATABASE_URL + migration 022 OU SENTINELA_AGENT_GATEWAY_NONCE_SQLITE_PATH
# persistent (n8n): SENTINELA_AGENT_GATEWAY_NONCE_CONSUME_URL + SENTINELA_AGENT_GATEWAY_INTERNAL_TOKEN
# SENTINELA_AGENT_GATEWAY_NONCE_CONSUME_URL=https://seu-app.vercel.app/api/v1/agent-gateway/nonce/consume
# SENTINELA_AGENT_GATEWAY_INTERNAL_TOKEN=
# B16-D2 — registry de identidades no consume API (server-side, fail-closed se ausente).
# Token interno por identidade + vínculo identity_id ↔ key_id(s). Preferir internal_token_sha256 em prod.
# SENTINELA_AGENT_GATEWAY_IDENTITY_REGISTRY=[{"identity_id":"uuid","internal_tokens":["token-n8n-parceiro"],"key_ids":["agent-demo"]}]
# SENTINELA_AGENT_GATEWAY_IDENTITY_REGISTRY_MODE=env
# postgres: migration 023 + DATABASE_URL (aplicar só com autorização explícita)
# API nonce/consume (Etapa 5): allowlist obrigatória — CSV ou JSON array de key_id (sem secrets)
# SENTINELA_AGENT_GATEWAY_ALLOWED_KEY_IDS=agent-demo,outro-key-id
# SENTINELA_AGENT_GATEWAY_NONCE_SQLITE_PATH=
# Qualquer outro valor (redis, supabase, production, typo) → 503 AGENT_GATEWAY_UNAVAILABLE.
# SENTINELA_AGENT_GATEWAY_TIMESTAMP_WINDOW_SECONDS=300
# memory_test (B16-B-R2) — somente harness local; nunca produção:
# SENTINELA_AGENT_GATEWAY_ALLOW_MEMORY_TEST=1
# SENTINELA_AGENT_GATEWAY_TEST_ENV=1
# SENTINELA_AGENT_GATEWAY_HARNESS_RUNTIME=local_n8n   # ou vitest (Vitest define VITEST=true)
# Nunca definir SENTINELA_AGENT_GATEWAY_PRODUCTION=1 com memory_test.
# Em NODE_ENV=production ou VERCEL_ENV=production, memory_test permanece bloqueado (503).
#
# Meta WhatsApp Cloud (n8n Variables / Credentials only). Leave empty here.
# Do not commit values. Do not use VITE_*.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Envio de e-mail de convite (Convidar por link) — configurar no Vercel
# Use a mesma API Key do Resend que está no Supabase (Authentication → E-mails → SMTP).
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remetente: use o MESMO Sender email do Supabase; domínio deve estar verificado no Resend (Domains).
RESEND_FROM=Qualivida <no-reply@phmsdev.com.br>

# (Opcional) Em desenvolvimento local: URL do backend para onde /api é proxiada (ex: sua URL na Vercel).
# Se não definir, em dev o proxy usa http://localhost:3001 — rode "npm run dev:api" para servir a API.
# VITE_API_BASE_URL=https://seu-app.vercel.app

# --- Master FASE C (server-side ONLY — nunca VITE_*) ---
# E-mails de sócios para provisionamento posterior. NÃO colocar senhas aqui.
# NÃO commitar e-mails reais. NÃO usar no frontend.
# PLATFORM_OWNER_EMAILS=socio1@example.com,socio2@example.com
# Script (não executa sozinho): node scripts/provision-platform-owners.mjs
# Requer SUPABASE_SERVICE_ROLE_KEY somente no ambiente server-side seguro.